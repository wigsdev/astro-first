---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import Footer from "../components/Footer.astro";
import productos from "../data/productos.json";

// filtrar únicamente los productos que se encuentran disponibles (disponible: true)
const productosDisponibles = productos.filter(
  (producto) => producto.disponible,
);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UchizaTech — Tienda de Tecnología</title>
  </head>
  <body>
    {/* integracion de Header, Hero, catalogo filtrado y Footer */}
    <Header />

    <main>
      <Hero />

      <section id="productos" class="contenedor-catalogo">
        <div class="catalogo-header">
          <h2>Catálogo de Productos</h2>
          <p>Mostrando {productosDisponibles.length} productos disonibles</p>
        </div>

        <div class="grid-productos">
          {
            productosDisponibles.map((prod) => (
              <Card
                nombre={prod.nombre}
                precio={prod.precio}
                imagen={prod.imagen}
                nuevo={prod.nuevo}
                categoria={prod.categoria}
              />
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    margin: 0;
    padding: 0;
    color: #1e293b;
    background-color: #f8fafc;
  }

  main {
    min-height: 80vh;
  }

  .contenedor-catalogo {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 3vw, 2rem);
  }

  .catalogo-header {
    text-align: center;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .catalogo-header h2 {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    color: #0f172a;
    margin: 0 0 0.5rem;
  }

  .catalogo-header p {
    color: #64748b;
    font-size: clamp(0.9rem, 1.8vw, 1rem);
    margin: 0;
  }

  .grid-productos {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, clamp(220px, 25vw, 260px)), 1fr)
    );
    gap: clamp(1rem, 2vw, 1.5rem);
  }
</style>
