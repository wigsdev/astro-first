---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";
import Banner from "../components/Banner.astro";

// Ejercicio 3: Lista de 4 beneficios para generar con map() y fragmentos
const beneficios = [
  { titulo: "Envío gratis", desc: "Por compras mayores a S/ 80" },
  { titulo: "Café de altura", desc: "Cosechado a más de 1800 msnm" },
  { titulo: "Tueste fresco", desc: "Tostado semanalmente" },
  { titulo: "Comercio justo", desc: "Trato directo con caficultores" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Café Andino</title>
  </head>
  <body>
    <Banner />
    <Header />

    <main>
      <h1>Café de altura de Cajamarca</h1>
      <div class="cards">
        <Card /><Card /><Card />
      </div>

      <!-- Ejercicio 3: Lista de beneficios con <dl> y fragmentos <dt>, <dd> -->
      <h2>Beneficios</h2>
      <dl>
        {
          beneficios.map((b) => (
            <>
              <dt>{b.titulo}</dt>
              <dd>{b.desc}</dd>
            </>
          ))
        }
      </dl>
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    margin: 0;
    color: #333;
    background-color: #fafafa;
  }
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
  }
  h1 {
    font-size: clamp(1.4rem, 4vw, 2rem);
    text-align: center;
    margin: clamp(1rem, 3vw, 2rem) 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, clamp(240px, 28vw, 260px)), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  h2 {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    margin-top: clamp(2rem, 5vw, 3rem);
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: clamp(0.3rem, 1vw, 0.5rem) clamp(0.75rem, 2vw, 1.25rem);
    align-items: baseline;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    color: #666;
  }
</style>
