---
import Layout from "../layouts/Layout.astro";
import libros from "../data/libros.json";

const totalLibros = libros.length;
const totalPaginas = libros.reduce(
  (acumulado, libro) => acumulado + libro.paginas,
  0,
);
---

<Layout>
  <main class="contenedor">
    <nav class="navegacion">
      <a href="/" class="enlace-volver">&larr; Volver al Inicio</a>
    </nav>

    <h1>Biblioteca de Libros</h1>

    <div class="resumen">
      <p>Total de libros: <strong>{totalLibros}</strong></p>
      <p>Total de páginas acumuladas: <strong>{totalPaginas}</strong></p>
    </div>

    <ul class="lista-libros">
      {
        libros.map((libro) => (
          <li>
            <strong>{libro.titulo}</strong> — {libro.autor} ({libro.paginas}{" "}
            páginas)
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

<style>
  .contenedor {
    padding: 2rem;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .navegacion {
    margin-bottom: 1.5rem;
  }
  .enlace-volver {
    display: inline-block;
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
  }
  .enlace-volver:hover {
    text-decoration: underline;
  }
  .resumen {
    background-color: #f1f5f9;
    border-left: 4px solid #3b82f6;
    padding: 0.75rem 1rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
  }
  .resumen p {
    margin: 0.25rem 0;
  }
  .lista-libros {
    line-height: 1.8;
  }
</style>
