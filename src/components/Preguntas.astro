---
const preguntas = [
  {
    pregunta: "¿Qué es astro?",
    respuesta: "un framework diseñado para la velocidad.",
  },
  {
    pregunta: "¿Qué son las islas?",
    respuesta: "componentes interactivos aislados en un mar de HTML estático",
  },
  {
    pregunta: "¿Usa JavaScript en el cliente?",
    respuesta: "Cero JavaScript por defecto, solo cuando lo necesitas.",
  },
  {
    pregunta: "¿Qué es un fragmento?",
    respuesta:
      "Una forma de agrupar elementos sin agregar etiquetas extra al DOM.",
  },
];
---

<dl class="faq-lista">
  {
    preguntas.map(({ pregunta, respuesta }) => (
      <>
        <dt>{pregunta}</dt>
        <dd>{respuesta}</dd>
      </>
    ))
  }
</dl>
