---
import Horario from "./Horario.astro";
import Carrito from "./Carrito.astro";
---

<main class="tienda-container">
  <h2>Nuestra Tienda</h2>
  <div class="tienda-grid">
    <Horario />
    <Carrito />
  </div>
</main>

<style>
  .tienda-container {
    padding: 1.5rem;
  }
  .tienda-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>
