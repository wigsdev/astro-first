    max-width: 650px;
    font-family: system-ui, sans-serif;
  }
  h2 {
    margin-top: 0;
    color: #1e293b;
    font-size: 1.25rem;
  }
  .instruccion {
    color: #475569;
    font-size: 0.95rem;
  }
  .demostracion {
    background: #ffffff;
    border: 2px dashed #94a3b8;
    padding: 1rem;
    border-radius: 6px;
    margin: 0.75rem 0;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .explicacion {
    color: #64748b;
    font-size: 0.85rem;
    display: block;
    margin-top: 0.5rem;
  }
</style>

