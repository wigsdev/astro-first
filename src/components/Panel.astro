---
import { configuracion } from "../data/configuracion.js";
---

<section class="panel">
  <h2>{configuracion.nombre}</h2>
  <p>{configuracion.descripcion}</p>
</section>
<style>
  .panel {
    border: 1px solid #e2e8f0;
    padding: 1.25rem;
    border-radius: 8px;
    background-color: #f8fafc;
    max-width: 400px;
    margin-top: 1rem;
  }
</style>
