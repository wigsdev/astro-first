---
// src/components/Alerta.astro

// 1. Tipamos las opciones válidas para la prop 'tipo'
interface Props {
  tipo?: "info" | "exito" | "error";
}

const { tipo = "info" } = Astro.props;

// 2. Título predeterminado según el tipo
const titulos = {
  info: "Info",
  exito: "Listo",
  error: "Error",
};

// 3. Clases de Tailwind según la variante
const estilos = {
  info: "bg-blue-50 border-blue-200 text-blue-800",
  exito: "bg-green-50 border-green-200 text-green-800",
  error: "bg-red-50 border-red-200 text-red-800",
};
---

<div
  class={`rounded-lg border p-4 mb-4 font-sans ${estilos[tipo]}`}
  role="alert"
>
  <strong class="font-bold">{titulos[tipo]}</strong>
  <div class="mt-1">
    <slot />
  </div>
</div>
