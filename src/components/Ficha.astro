---
// Variables con información personal
const nombre = "Wilmer";
const ciudad = "Uchiza";
const hobby = "Frontend Developer";
const lenguajeFavorito = "JavaScript";
---

<section class="ficha-card">
  <h2>Ficha Personal</h2>
  <ul>
    <li><strong>Nombre:</strong> {nombre}</li>
    <li><strong>Ciudad:</strong> {ciudad}</li>
    <li><strong>Hobby:</strong> {hobby}</li>
    <li><strong>Lenguaje favorito:</strong> {lenguajeFavorito}</li>
  </ul>
</section>
<style>
  .ficha-card {
    border: 1px solid #e2e8f0;
    padding: 1.25rem;
    border-radius: 8px;
    background-color: #f8fafc;
    max-width: 400px;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    margin-bottom: 0.5rem;
  }
</style>
