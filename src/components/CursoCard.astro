---
// src/components/CursoCard.astro
interface Modulo {
  titulo: string;
  temas: string[];
}

interface Props {
  nombre: string;
  destacado: boolean;
  disponible: boolean;
  precio: number;
  calificacion: number;
  alumnos: number;
  imagen: string;
  nivel: string;
  horas: number;
  descripcionHtml: string;
  modulos: Modulo[];
}

const {
  nombre,
  destacado,
  disponible,
  precio,
  calificacion,
  alumnos,
  imagen,
  nivel,
  horas,
  descripcionHtml,
  modulos,
} = Astro.props;

// Requisito 2: Etiqueta dinámica (h2 si es destacado, h3 si no lo es)
const TituloTag = destacado ? "h2" : "h3";
---

<article class={`course-card ${destacado ? "featured" : ""}`}>
  {/* Imagen de portada de la tarjeta con badges de estado */}
  <div class="cover-container">
    <img src={imagen} alt={nombre} class="cover-img" />
    <div class="floating-badges">
      {destacado && <span class="badge badge-featured">Destacado</span>}
      {disponible && <span class="badge badge-available">En vivo</span>}
    </div>
  </div>

  <div class="card-body">
    {/* Metadatos rápidos: Valoración y estudiantes */}
    <div class="card-meta">
      <span class="rating">⭐ {calificacion.toFixed(1)}</span>
      <span class="students">({alumnos} estudiantes)</span>
    </div>

    {/* Requisito 2: Título con etiqueta dinámica */}
    <TituloTag class="course-title">
      {nombre}
    </TituloTag>

    {/* Requisito 5: Descripción comercial renderizada con Fragment set:html */}
    <div class="course-description">
      <Fragment set:html={descripcionHtml} />
    </div>

    {/* Requisito 4: Ficha técnica en <dl> usando fragmentos */}
    <div class="specs-section">
      <dl class="course-specs">
        <>
          <dt>Nivel:</dt>
          <dd>{nivel}</dd>
        </>
        <>
          <dt>Duración:</dt>
          <dd>{horas} horas</dd>
        </>
        <>
          <dt>Módulos:</dt>
          <dd>{modulos.length} módulos</dd>
        </>
      </dl>
    </div>

    {/* Precio y disponibilidad */}
    <div class="price-row">
      <span class="price-label">Precio oficial:</span>
      <span class="price-amount">S/ {precio.toFixed(2)}</span>
    </div>

    {/* Requisito 3: Temario con doble map() encapsulado limpiamente en un acordeón nativo HTML5 */}
    <details class="syllabus-accordion">
      <summary class="accordion-btn">
        Ver temario completo ({modulos.length} módulos) ▾
      </summary>
      <div class="accordion-content">
        <ol class="modules-list">
          {modulos.map((modulo) => (
            <li class="module-item">
              <strong>{modulo.titulo}</strong>
              <ul class="topics-list">
                {modulo.temas.map((tema) => (
                  <li>{tema}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </details>
  </div>
</article>

<style>
  .course-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .course-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .course-card.featured {
    border-color: var(--color-primary);
  }

  .cover-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-text-heading);
    overflow: hidden;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .floating-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    gap: 0.5rem;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .badge-featured {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .badge-available {
    background-color: var(--color-success);
    color: #ffffff;
  }

  .card-body {
    padding: clamp(1rem, 2.5vw, 1.35rem);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .rating {
    font-weight: 700;
    color: var(--color-warning);
  }

  .students {
    color: var(--color-text-muted);
  }

  .course-title {
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  h2.course-title {
    font-size: clamp(1.2rem, 2.5vw, 1.4rem);
    color: var(--color-text-heading);
  }

  h3.course-title {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-body);
  }

  .course-description {
    color: var(--color-text-muted);
    font-size: clamp(0.85rem, 1.8vw, 0.92rem);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .course-description p {
    margin: 0;
  }

  .specs-section {
    background-color: var(--color-bg);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.85rem;
    margin-bottom: 0.85rem;
  }

  .course-specs {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-size: 0.85rem;
  }

  .course-specs dt {
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .course-specs dd {
    margin: 0;
    color: var(--color-text-body);
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-border-subtle);
    margin-top: auto;
    margin-bottom: 0.75rem;
  }

  .price-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .price-amount {
    font-size: clamp(1.15rem, 2.5vw, 1.35rem);
    font-weight: 800;
    color: var(--color-primary);
  }

  /* Acordeón nativo para el temario */
  .syllabus-accordion {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 0.65rem;
  }

  .accordion-btn {
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    user-select: none;
    list-style: none;
    text-align: center;
    padding: 0.4rem;
    background-color: var(--color-primary-light);
    border-radius: 5px;
    transition: background-color 0.15s ease;
  }

  .accordion-btn::-webkit-details-marker {
    display: none;
  }

  .accordion-btn:hover {
    background-color: var(--color-primary-badge);
  }

  .accordion-content {
    margin-top: 0.75rem;
    padding: 0.75rem;
    background-color: var(--color-bg);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
  }

  .modules-list {
    margin: 0;
    padding-left: 1.15rem;
  }

  .module-item {
    margin-bottom: 0.5rem;
  }

  .topics-list {
    margin: 0.2rem 0 0;
    padding-left: 1.15rem;
    color: var(--color-text-muted);
  }
</style>
